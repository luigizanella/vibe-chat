# ---------------------------------------------------------------------------
# Variáveis PÚBLICAS do frontend (vão para o bundle — nunca coloque segredos aqui)
# Copie para ".env.local" e preencha.
# ---------------------------------------------------------------------------

# Supabase: Project Settings > API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "anon" / "publishable" (segura para o navegador; a proteção real é o RLS)
VITE_SUPABASE_ANON_KEY=

# URL pública do app web (usada nos links de convite e redirecionamentos de e-mail).
# Em dev: http://localhost:5173. Deixe vazio para usar a origem atual.
VITE_PUBLIC_APP_URL=

# ---------------------------------------------------------------------------
# SEGREDOS DO SERVIDOR — NÃO ficam aqui. Configure no Supabase:
#   supabase secrets set LIVEKIT_URL=wss://... LIVEKIT_API_KEY=... LIVEKIT_API_SECRET=...
# (SUPABASE_SERVICE_ROLE_KEY é injetado automaticamente nas Edge Functions)
# ---------------------------------------------------------------------------
